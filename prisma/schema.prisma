generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Member {
  id          String          @id @default(cuid())
  memberId    String          @unique
  name        String
  email       String          @unique
  photo       String?
  birthday    DateTime?
  role        String          @default("学员")
  totalPoints Int             @default(0)
  userId      String?         @unique
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendances AttendanceLog[]
  redemptions Redemption[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([memberId])
}

model AttendanceLog {
  id           String   @id @default(cuid())
  dateTime     DateTime @default(now())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventName    String
  pointsEarned Int      @default(1)
  createdAt    DateTime @default(now())

  @@index([memberId, eventName, dateTime])
}

model Reward {
  id             String       @id @default(cuid())
  name           String
  pointsRequired Int
  image          String?
  description    String?
  stock          Int          @default(10)
  redemptions    Redemption[]
  createdAt      DateTime     @default(now())
}

model Redemption {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rewardId    String
  reward      Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  pointsSpent Int
  createdAt   DateTime @default(now())

  @@index([memberId])
}

model Event {
  id          String            @id @default(cuid())
  name        String
  description String?
  dateTime    DateTime
  location    String?
  points      Int               @default(1)
  tokens      AttendanceToken[]
  attendances Attendance[]
  createdAt   DateTime          @default(now())
}

model AttendanceToken {
  id         String      @id @default(cuid())
  token      String      @unique
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  isUsed     Boolean     @default(false)
  usedAt     DateTime?
  createdAt  DateTime    @default(now())
  attendance Attendance?

  @@index([expiresAt])
  @@index([eventId])
}

model Attendance {
  id          String          @id @default(cuid())
  eventId     String
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId   String
  tokenId     String          @unique
  token       AttendanceToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  checkedInAt DateTime        @default(now())

  @@unique([eventId, studentId])
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  birthday        DateTime?
  role            String         @default("学员")
  passwordHash    String
  resetCode       String?
  resetCodeExpiry DateTime?
  resetAttempts   Int            @default(0)
  member          Member?
  zenGameScores   ZenGameScore[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ── Zen Rhythm Game Score ────────────────────────────────────────
model ZenGameScore {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int
  maxCombo    Int
  trackName   String?
  achievedAt  DateTime @default(now())

  @@index([userId])
}

// ── Lotus Sea Lamp ───────────────────────────────────────────────
model Lamp {
  id          String   @id @default(cuid())
  userId      String
  userName    String   @default("同修")
  posX        Float
  posY        Float    @default(0)
  posZ        Float
  message     String?  @default("愿平安吉祥")
  prayerCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
